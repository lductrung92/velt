{
  "name": "@zukatek/site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "npm run typecheck && vite build && vite build --ssr app/entry-server.tsx",
    "preview": "node server.mjs --production",
    "start": "node server.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.tsx",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@remotion/player": "4.0.534",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-select": "^5.10.2",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}
