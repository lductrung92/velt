# Production build. Vite loads .env.[mode] AFTER .env.local, so this is what a
# `vite build` uses no matter what a developer has in their own .env.local —
# which is exactly the bug this file fixes: the first production bundle shipped
# with http://localhost:8081 baked in, because VITE_ vars are inlined at BUILD
# time, not read at runtime.
VITE_API_BASE_URL=https://api.zukatek.com/api
