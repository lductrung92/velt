# Console (Vite) env. Copy to .env.local (gitignored) per machine.
# Vite only exposes vars prefixed with VITE_.

# Backend API base — includes the /api prefix. Dev via Caddy vhost or localhost.
VITE_API_BASE_URL=https://api.velt.local.vn/api
# Local (no vhost): VITE_API_BASE_URL=http://localhost:8000/api
