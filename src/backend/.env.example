# Backend environment template. Copy to .env and fill in real values.
# .env is gitignored; this .example file is committed. Never commit secrets.

# ── App ─────────────────────────────────────────────────
APP_ENV=dev          # dev | staging | prod
HTTP_ADDR=:8080
LOG_LEVEL=info        # debug | info | warn | error
LOG_FILE=            # also tee JSON logs to this file (e.g. logs/app.log); empty = stdout only

# ── Database (REQUIRED) ─────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/velt?sslmode=disable

# Separate DB for `go test` integration tests. Empty → those tests skip.
# NEVER point this at a database holding real data (tests insert rows).
TEST_DATABASE_URL=

# ── Redis (optional) ────────────────────────────────────
# Empty → in-memory rate limiter (single instance only). Set for multi-instance.
REDIS_URL=redis://127.0.0.1:6379/0

# ── Secrets (REQUIRED — generate fresh per environment) ─
# JWT_SECRET:     openssl rand -base64 48   (staff access/challenge tokens)
# ENCRYPTION_KEY: openssl rand -hex 32      (32-byte AES-256 key; hex or base64)
JWT_SECRET=
ENCRYPTION_KEY=

# ── Token lifetimes ─────────────────────────────────────
ACCESS_TOKEN_TTL=15m
CHALLENGE_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=720h
RESET_TOKEN_TTL=30m

# ── Login security ──────────────────────────────────────
MAX_FAILED_LOGINS=5
LOCKOUT_BASE=1m
SESSION_CAP=10

# ── Refresh cookie ──────────────────────────────────────
COOKIE_SECURE=true    # true in staging/prod (HTTPS); false for local http
COOKIE_DOMAIN=

# Trust X-Forwarded-For/X-Real-IP for client IP (rate-limit bucketing).
# Set true ONLY behind a trusted reverse proxy that strips/sets these headers;
# otherwise clients could spoof them to evade per-IP limits.
TRUST_PROXY_HEADERS=false

# ── Outbound ────────────────────────────────────────────
APP_BASE_URL=http://localhost:5173            # console base for staff password-reset links
CUSTOMER_WEB_BASE_URL=http://localhost:3000   # public site base — on-publish revalidation target
MAIL_FROM=no-reply@velt.local.vn

# Shared secret for the web's POST /api/revalidate (must match web REVALIDATE_SECRET).
# Empty → on-publish revalidation is disabled (content relies on the ISR window).
REVALIDATE_SECRET=change-me

# ── CORS ────────────────────────────────────────────────
# Browser origins allowed to call the API with credentials (comma-separated).
# Console/web are separate origins from the API, so cross-origin needs this.
CORS_ALLOWED_ORIGINS=https://admin.velt.local.vn,https://velt.local.vn,http://localhost:5173,http://localhost:3000
