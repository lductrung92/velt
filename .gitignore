.env
!.env.example

# ── Pytest / coverage ───────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Dev SQLite databases ────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/uploads/

# ── Backend runtime logs ────────────────────────────────
backend/logs/

# ── Coverage / Sonar artifacts ──────────────────────────
backend/coverage.xml
backend/.coverage
console/coverage/
.scannerwork/
.sonar/
.sonarwork/

# ── Script-local secrets (SONAR_TOKEN etc.) ─────────────
scripts/.env
!scripts/.env.example

# ── Project identity for config templates (render-config.sh) ─────────────
scripts/config/project.env
!scripts/config/project.env.example

# ── Claude Code per-user settings ───────────────────────
.claude/settings.local.json

# ── Ruff ────────────────────────────────────────────────
.ruff_cache/

# ── Node / npm ──────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Vite / console build ───────────────────────────────
console/dist/
console/.env
!console/.env.example

# ── OS ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── Secrets ─────────────────────────────────────────────
*.pem
*.key
*.cert
secrets.json

.run-logs/

# ── Runtime logs ───────────────────────────────────────
logs/
test-results
feedback/

# ── Local seed fixtures (re-generated by the scraper) ─
backend/seeds/demo/properties.json
backend/seeds/demo/images/
.claude/scheduled_tasks.lock

# Domain verification files (Zalo / Meta / Google) — per-tunnel,
# per-developer. Keep directory + .gitkeep but ignore actual drops.
backend/verifier_files/*
!backend/verifier_files/.gitkeep
vn_provinces
scripts/.scrape
# Local file storage (avatars, uploads via local driver)
backend/storage/

# air hot-reload build output
backend/tmp/
sessions/
.claude
.codex
.wolf
mockup/
tham-khao/

# Local dev run logs (scripts/dev.ps1 output redirected here)
dev-start.log
dev-start.error.log
